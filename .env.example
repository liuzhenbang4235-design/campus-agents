# 云端模型配置模板。复制为 .env 后填写真实值；.env 不提交到 Git。
# 优先级：系统环境变量 > .env > config.local.json。
# 修改 .env 后需重启 node server.cjs 才生效。

# 云端模型开关：true 才启用；false 或不写时只使用本地检索。
CAMPUS_AI_ENABLED=false

# 服务商：deepseek / qwen / doubao 三选一。
CAMPUS_AI_PROVIDER=deepseek

# 服务商控制台生成的 API Key。不要填到聊天或提交到仓库。
CAMPUS_AI_API_KEY=

# 模型 ID：填控制台调用示例里的 model。
# DeepSeek 当前使用 deepseek-flash（推荐）或 deepseek-v4-pro；
# deepseek-chat / deepseek-reasoner 已于 2026-07-24 停用，不要再填。
CAMPUS_AI_MODEL=

# 本机每日最多调用次数，可选正整数；不填按 50。
CAMPUS_AI_DAILY_LIMIT=50
