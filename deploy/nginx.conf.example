# =============================================================================
# 校集 Campus Agent — nginx TLS 反向代理示例
# 放置：/etc/nginx/conf.d/campus-agent.conf（Debian/Ubuntu/RHEL 的 conf.d 均在 http{} 内）
# 使用前替换：campus.example.com、证书路径、日志路径、ACME webroot
#
# 重要：
#   1) 必须透传浏览器原始 Host（proxy_set_header Host $host），
#      否则应用会返回 403「无效的访问地址。」
#   2) 应用已自行下发 CSP / X-Frame-Options / X-Content-Type-Options /
#      Referrer-Policy，这里不要重复添加，重复会导致策略叠加/冲突。
#   3) 应用只监听 127.0.0.1:4173；本文件不要把上游改成 0.0.0.0。
#   4) 启动应用时必须带 CAMPUS_ORIGINS=https://campus.example.com
# =============================================================================

# ---- HTTP:80 → HTTPS，同时保留 ACME HTTP-01 校验 ----------------------------
server {
    listen      80;
    listen      [::]:80;
    server_name campus.example.com;

    # certbot --webroot 的校验目录（按实际 webroot 修改）
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---- HTTPS:443 反向代理 -----------------------------------------------------
server {
    # nginx ≥ 1.25.1 推荐写成：listen 443 ssl;  +  http2 on;
    # 这里保留兼容写法，旧版本也能直接使用。
    listen      443 ssl http2;
    listen      [::]:443 ssl http2;
    server_name campus.example.com;

    # ---- 证书（Let's Encrypt 示例路径）-------------------------------------
    ssl_certificate     /etc/letsencrypt/live/campus.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/campus.example.com/privkey.pem;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    # ---- 日志 --------------------------------------------------------------
    access_log /var/log/nginx/campus-agent.access.log;
    error_log  /var/log/nginx/campus-agent.error.log warn;

    server_tokens off;

    # ---- 请求体限制 --------------------------------------------------------
    # 应用把 JSON 上限卡在 100000 字节（上传只存文件名，无文件流）。
    # 设 128k：100k–128k 的请求仍由应用返回结构化 413 JSON；
    # 超过 128k 才由 nginx 直接拒绝。
    client_max_body_size 128k;
    client_body_timeout  15s;
    client_header_timeout 10s;

    # ---- HSTS：确认 HTTPS 长期稳定后再取消注释 ------------------------------
    # 应用本身不发送 HSTS；这是代理层唯一建议额外添加的安全头。
    # 如果以后可能退回 HTTP，或还有子域未上 HTTPS，请勿开启 includeSubDomains。
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        proxy_pass http://127.0.0.1:4173;

        # 保持长连接，避免每个请求重新握手
        proxy_http_version 1.1;
        proxy_set_header   Connection "";

        # ---- 必须原样转发 Host（应用按 Host 白名单校验）--------------------
        proxy_set_header Host              $host;   # 不带端口；443 标准端口正确
        proxy_set_header X-Forwarded-Proto $scheme; # 应用据此/据 CAMPUS_ORIGINS 决定 Secure Cookie
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;

        # 若使用非 443 端口（如 https://campus.example.com:8443），
        # 把上面 Host 改成 $http_host，否则 Host 少端口会 403。

        # ---- 超时：模型回答可能较慢；应用接收请求超时为 70000ms，留足余量 ------
        proxy_connect_timeout 5s;
        proxy_send_timeout    75s;
        proxy_read_timeout    75s;
        send_timeout          75s;

        # 默认开启缓冲即可；应用响应都是小 JSON / 静态文件。
        proxy_buffering on;
        proxy_request_buffering on;

        # 不要在此处 add_header CSP / X-Frame-Options / nosniff（应用已发）。
        # 不要缓存 /api/*；应用已发送 Cache-Control: no-store。
        # 不要改写或删除 Set-Cookie。
    }
}
